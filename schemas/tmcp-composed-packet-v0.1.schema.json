{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakyeamos/tmcp/schemas/tmcp-composed-packet-v0.1.schema.json",
  "title": "TMCP Composed Packet v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "packet_id",
    "objective",
    "project_path",
    "phase",
    "active_instructions",
    "required_reads",
    "tool_script_prompts",
    "verification_gates",
    "stop_conditions",
    "active_atoms",
    "deferred_atoms",
    "ignored_sources",
    "conflicts",
    "evidence_citations",
    "global_cache",
    "receipt_template",
    "safety"
  ],
  "properties": {
    "schema": {
      "const": "tmcp-composed-packet-v0.1"
    },
    "packet_id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "project_path": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "active_instructions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_reads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tool_script_prompts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active_atoms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deferred_atoms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ignored_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "evidence_citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "global_cache": {
      "type": "object",
      "additionalProperties": true
    },
    "receipt_template": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema",
        "packet_id",
        "activated_atoms",
        "ignored_atoms",
        "commands_run",
        "verification_results",
        "user_overrides",
        "outcome"
      ],
      "properties": {
        "schema": {
          "const": "tmcp-run-receipt-v0.1"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
