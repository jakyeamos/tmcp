{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakyeamos/tmcp/schemas/tmcp-behavioral-atoms-semantic-preflight-v0.3.schema.json",
  "title": "TMCP Behavioral Atoms Semantic Preflight v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "version",
    "created_at",
    "status",
    "base",
    "scope",
    "generic_process_shell",
    "typed_atom_contract",
    "domain_atom_catalog",
    "family_signatures",
    "fixture_artifact",
    "transplant_arms",
    "interaction_selection_policy",
    "interaction_hypotheses",
    "compatibility_risk",
    "gate_dispositions",
    "validation_gate"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "tmcp-behavioral-atoms-semantic-preflight-v0.3"
    },
    "version": {
      "const": "0.3.0"
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "structurally_valid_preflight"
    },
    "base": {
      "$ref": "#/$defs/base"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "generic_process_shell": {
      "$ref": "#/$defs/processShell"
    },
    "typed_atom_contract": {
      "$ref": "#/$defs/typedAtomContract"
    },
    "domain_atom_catalog": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/domainAtom"
      }
    },
    "family_signatures": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "enum": [
              "data_integrity",
              "security_privacy",
              "release_readiness",
              "migration_readiness"
            ]
          }
        }
      }
    },
    "fixture_artifact": {
      "$ref": "#/$defs/artifactReference"
    },
    "transplant_arms": {
      "$ref": "#/$defs/transplantRegistry"
    },
    "interaction_selection_policy": {
      "$ref": "#/$defs/interactionSelectionPolicy"
    },
    "interaction_hypotheses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/interactionHypothesis"
      }
    },
    "compatibility_risk": {
      "$ref": "#/$defs/compatibilityRisk"
    },
    "gate_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gateDisposition"
      }
    },
    "validation_gate": {
      "$ref": "#/$defs/validationGate"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "objectArray": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "source_branch",
        "branch_state",
        "public_runtime_schema_changed"
      ],
      "properties": {
        "repository": {
          "const": "jakyeamos/tmcp"
        },
        "commit": {
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_branch": {
          "const": "main"
        },
        "branch_state": {
          "const": "detached HEAD at source branch main"
        },
        "public_runtime_schema_changed": {
          "const": false
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "runtime_implementation",
        "provider_cells",
        "cross_skill_composition_support",
        "excluded"
      ],
      "properties": {
        "mode": {
          "const": "preflight_only"
        },
        "runtime_implementation": {
          "const": "not_started"
        },
        "provider_cells": {
          "const": "not_run"
        },
        "cross_skill_composition_support": {
          "const": "not_claimed"
        },
        "excluded": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "processShell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "atom_ids",
        "obligations",
        "satisfies_domain_obligations",
        "rendering_boundary"
      ],
      "properties": {
        "id": {
          "const": "process-shell.evidence-first"
        },
        "version": {
          "const": "0.3.0"
        },
        "atom_ids": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "pattern": "^process\\."
          }
        },
        "obligations": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "satisfies_domain_obligations": {
          "const": false
        },
        "rendering_boundary": {
          "$ref": "#/$defs/renderingBoundary"
        }
      }
    },
    "typedAtomContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "stable_identity",
        "required_fields",
        "applicability_outcomes",
        "applicability_rule",
        "dependency_rule",
        "conflict_rule",
        "provenance_trust",
        "rendering_boundary",
        "estimated_token_cost"
      ],
      "properties": {
        "schema": {
          "const": "tmcp-typed-atom-contract-v0.3"
        },
        "stable_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "version",
            "identity_rule",
            "stability"
          ],
          "properties": {
            "namespace": {
              "const": "tmcp.behavior"
            },
            "version": {
              "const": "0.3.0"
            },
            "identity_rule": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "stability": {
              "const": "research_preflight"
            }
          }
        },
        "required_fields": {
          "type": "array",
          "minItems": 13,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "required",
              "purpose"
            ],
            "properties": {
              "name": {
                "enum": [
                  "stable_identity",
                  "domain_semantics",
                  "applicability",
                  "dependencies",
                  "conflicts",
                  "required_inputs",
                  "required_reads",
                  "evidence_obligations",
                  "verification_obligations",
                  "stop_conditions",
                  "provenance_trust",
                  "rendering_boundary",
                  "estimated_token_cost"
                ]
              },
              "type": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "required": {
                "const": true
              },
              "purpose": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        "applicability_outcomes": {
          "type": "array",
          "const": [
            "positive",
            "negative",
            "ambiguous"
          ]
        },
        "applicability_rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "dependency_rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "conflict_rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "provenance_trust": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trusted_sources",
            "untrusted_inputs",
            "rule"
          ],
          "properties": {
            "trusted_sources": {
              "$ref": "#/$defs/stringArray"
            },
            "untrusted_inputs": {
              "$ref": "#/$defs/stringArray"
            },
            "rule": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "rendering_boundary": {
          "$ref": "#/$defs/renderingBoundary"
        },
        "estimated_token_cost": {
          "$ref": "#/$defs/tokenCost"
        }
      }
    },
    "domainAtom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "family",
        "domain_semantics",
        "applicability",
        "dependencies",
        "conflicts",
        "required_inputs",
        "required_reads",
        "evidence_obligations",
        "verification_obligations",
        "stop_conditions",
        "provenance_trust",
        "rendering_boundary",
        "estimated_token_cost"
      ],
      "properties": {
        "id": {
          "pattern": "^domain\\.[a-z_]+\\.[a-z0-9_]+$"
        },
        "version": {
          "const": "0.3.0"
        },
        "family": {
          "enum": [
            "data_integrity",
            "security_privacy",
            "release_readiness",
            "migration_readiness"
          ]
        },
        "domain_semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "risk",
            "expected_output"
          ],
          "properties": {
            "target": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "risk": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "expected_output": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "dependencies": {
          "$ref": "#/$defs/stringArray"
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "when",
              "resolution"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "when": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "resolution": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        "required_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "kind": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        "required_reads": {
          "$ref": "#/$defs/stringArray"
        },
        "evidence_obligations": {
          "$ref": "#/$defs/stringArray"
        },
        "verification_obligations": {
          "$ref": "#/$defs/stringArray"
        },
        "stop_conditions": {
          "$ref": "#/$defs/stringArray"
        },
        "provenance_trust": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_path",
            "source_sha256",
            "trust",
            "input_policy"
          ],
          "properties": {
            "source_path": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "source_sha256": {
              "pattern": "^[0-9a-f]{64}$"
            },
            "trust": {
              "const": "committed_source_backed"
            },
            "input_policy": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "rendering_boundary": {
          "$ref": "#/$defs/renderingBoundary"
        },
        "estimated_token_cost": {
          "$ref": "#/$defs/tokenCost"
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "negative",
        "ambiguous",
        "ambiguous_action"
      ],
      "properties": {
        "positive": {
          "$ref": "#/$defs/stringArray"
        },
        "negative": {
          "$ref": "#/$defs/stringArray"
        },
        "ambiguous": {
          "$ref": "#/$defs/stringArray"
        },
        "ambiguous_action": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "renderingBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renderable_to",
        "forbidden"
      ],
      "properties": {
        "renderable_to": {
          "$ref": "#/$defs/stringArray"
        },
        "forbidden": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "tokenCost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "minimum",
        "maximum",
        "measure"
      ],
      "properties": {
        "unit": {
          "const": "estimated_tokens"
        },
        "minimum": {
          "type": "integer",
          "minimum": 0
        },
        "maximum": {
          "type": "integer",
          "minimum": 1
        },
        "measure": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema",
        "sha256",
        "split",
        "counts"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "schema": {
          "const": "tmcp-behavioral-atoms-held-out-fixtures-v0.3"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$"
        },
        "split": {
          "const": "held_out"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "positive",
            "negative",
            "ambiguous",
            "per_family"
          ],
          "properties": {
            "total": {
              "const": 12
            },
            "positive": {
              "const": 4
            },
            "negative": {
              "const": 4
            },
            "ambiguous": {
              "const": 4
            },
            "per_family": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "data_integrity",
                "security_privacy",
                "release_readiness",
                "migration_readiness"
              ],
              "properties": {
                "data_integrity": {
                  "const": 3
                },
                "security_privacy": {
                  "const": 3
                },
                "release_readiness": {
                  "const": 3
                },
                "migration_readiness": {
                  "const": 3
                }
              }
            }
          }
        }
      }
    },
    "transplantRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_rule",
        "valid",
        "rejected_historical_shapes"
      ],
      "properties": {
        "selection_rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "valid": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "id": {
                "pattern": "^arm\\.valid\\."
              },
              "status": {
                "const": "valid"
              }
            }
          }
        },
        "rejected_historical_shapes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "status",
              "reason_code"
            ],
            "properties": {
              "id": {
                "pattern": "^arm\\.invalid\\."
              },
              "status": {
                "const": "invalid"
              },
              "reason_code": {
                "enum": [
                  "duplicate_generic_condition",
                  "no_eligible_variant"
                ]
              }
            }
          }
        }
      }
    },
    "interactionHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "selection_basis",
        "families",
        "atom_refs",
        "predicted_direction",
        "mechanism",
        "falsifier",
        "held_out_evaluation_boundary"
      ],
      "properties": {
        "id": {
          "pattern": "^H[0-9]+\\."
        },
        "selection_basis": {
          "const": "domain_logic"
        },
        "families": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "data_integrity",
              "security_privacy",
              "release_readiness",
              "migration_readiness"
            ]
          }
        },
        "atom_refs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "pattern": "^domain\\.[a-z_]+\\.[a-z0-9_]+@0\\.3\\.0$"
          }
        },
        "predicted_direction": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "mechanism": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "falsifier": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "held_out_evaluation_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fixture_ids",
            "tuning_allowed",
            "outcome_data_allowed",
            "owner"
          ],
          "properties": {
            "fixture_ids": {
              "$ref": "#/$defs/stringArray"
            },
            "tuning_allowed": {
              "const": false
            },
            "outcome_data_allowed": {
              "const": false
            },
            "owner": {
              "const": "behavioral_atoms_preflight"
            }
          }
        }
      }
    },
    "interactionSelectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_basis",
        "lexicographic_enumeration",
        "exhaustive_pair_generation",
        "selected_count_rule"
      ],
      "properties": {
        "selection_basis": {
          "const": "domain_logic"
        },
        "lexicographic_enumeration": {
          "const": "forbidden"
        },
        "exhaustive_pair_generation": {
          "const": false
        },
        "selected_count_rule": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "compatibilityRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "no_public_runtime_schema_change",
        "risks",
        "mitigations"
      ],
      "properties": {
        "status": {
          "const": "documented_only"
        },
        "no_public_runtime_schema_change": {
          "const": true
        },
        "risks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "description": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        "mitigations": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "gateDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "disposition"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "passed",
            "blocked",
            "not_run",
            "not_applicable"
          ]
        },
        "disposition": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "command": {
          "type": "string"
        }
      }
    },
    "validationGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "fail_closed",
        "admission_rule",
        "implementation_boundary",
        "checks"
      ],
      "properties": {
        "id": {
          "const": "semantic-preflight-v0.3"
        },
        "status": {
          "enum": [
            "passed",
            "not_run",
            "blocked"
          ]
        },
        "fail_closed": {
          "const": true
        },
        "admission_rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "implementation_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime_registry",
            "compiler",
            "evaluator",
            "provider_cells"
          ],
          "properties": {
            "runtime_registry": {
              "const": "not_started"
            },
            "compiler": {
              "const": "not_started"
            },
            "evaluator": {
              "const": "not_started"
            },
            "provider_cells": {
              "const": "not_run"
            }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "command"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "status": {
                "enum": [
                  "passed",
                  "not_run",
                  "blocked"
                ]
              },
              "command": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      }
    }
  }
}
