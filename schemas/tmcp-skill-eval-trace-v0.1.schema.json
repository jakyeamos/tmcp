{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakyeamos/tmcp/schemas/tmcp-skill-eval-trace-v0.1.schema.json",
  "title": "TMCP Skill Evaluation Trace v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "task_id",
    "variant_id",
    "observations"
  ],
  "properties": {
    "schema": {
      "const": "tmcp-skill-eval-trace-v0.1"
    },
    "trace_id": {
      "type": "string"
    },
    "experiment_id": {
      "type": "string"
    },
    "matrix_row_id": {
      "type": "string"
    },
    "replicate_id": {
      "type": ["string", "integer"]
    },
    "task_id": {
      "type": "string"
    },
    "variant_id": {
      "type": "string"
    },
    "agent": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "model": {"type": "string"},
        "configuration_id": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "runner_blinded": {"type": "boolean"},
        "judge_blinded": {"type": "boolean"},
        "isolated_session": {"type": "boolean"}
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "value"],
        "properties": {
          "kind": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "human_labels": {
      "type": "array"
    },
    "case_verdict": {
      "type": "object",
      "properties": {
        "passed": {"type": "boolean"},
        "evidence": {
          "type": "array",
          "items": {"type": ["string", "object"]}
        },
        "safety_regression": {"type": "boolean"},
        "cost_regression": {"type": "boolean"}
      }
    },
    "outcome": {
      "type": "string"
    }
  }
}
