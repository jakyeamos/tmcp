{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakyeamos/tmcp/schemas/tmcp-adaptive-workflow-pack-v0.1.schema.json",
  "title": "TMCP Adaptive Workflow Pack v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "artifact_type",
    "harvested_source_map",
    "operating_profile",
    "strongest_behavior_signals",
    "recommended_default_templates",
    "generated_custom_workflow_ideas",
    "suggested_routing_triggers",
    "documented_process_gaps",
    "next_workflow_selection"
  ],
  "properties": {
    "schema": {
      "const": "tmcp-adaptive-workflow-pack-v0.1"
    },
    "artifact_type": {
      "const": "adaptive_workflow_pack"
    },
    "harvested_source_map": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "operating_profile": {
      "type": "object",
      "additionalProperties": true
    },
    "strongest_behavior_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "overlap_analysis": {
      "type": "object",
      "additionalProperties": true
    },
    "recommended_default_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name", "signal_family"],
        "additionalProperties": true,
        "properties": {
          "kind": {
            "const": "default_template"
          }
        }
      }
    },
    "generated_custom_workflow_ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "basis", "why", "approval_required"],
        "additionalProperties": true
      }
    },
    "suggested_routing_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "documented_process_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "message"],
        "additionalProperties": true
      }
    },
    "next_workflow_selection": {
      "type": "object",
      "required": ["approval_required", "instruction"],
      "additionalProperties": true,
      "properties": {
        "approval_required": {
          "const": true
        }
      }
    }
  }
}
