{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakyeamos/tmcp/schemas/tmcp-skill-packet-v0.2.schema.json",
  "title": "TMCP Skill Packet v0.2",
  "type": "object",
  "required": [
    "schema",
    "receipt_schema",
    "status",
    "adapter",
    "task_id",
    "objective",
    "project_path",
    "source_graph_version",
    "entry_node",
    "selected_nodes",
    "skipped_nodes",
    "selected_branches",
    "source_skill_nodes",
    "behavior_atoms",
    "shortcut_candidate",
    "shortcut_governance",
    "transition_trace",
    "traversal_fingerprint",
    "token_estimates",
    "output_contract",
    "packet_markdown"
  ],
  "properties": {
    "schema": {
      "const": "tmcp-skill-packet-v0.2"
    },
    "receipt_schema": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "adapter": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "project_path": {
      "type": ["string", "null"]
    },
    "source_graph_version": {
      "type": "string"
    },
    "entry_node": {
      "type": "string"
    },
    "selected_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skipped_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selected_branches": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "source_skill_nodes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "substance_check": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "tmcp-packet-substance-v0.1"
        },
        "level": {
          "enum": ["process_only", "thin_domain_signals", "source_backed_playbook"]
        },
        "has_domain_playbook": {
          "type": "boolean"
        },
        "fallback_policy": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "behavior_atoms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shortcut_candidate": {
      "type": "object"
    },
    "shortcut_governance": {
      "type": "object"
    },
    "transition_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "action", "why"],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "traversal_fingerprint": {
      "type": "string"
    },
    "token_estimates": {
      "type": "object"
    },
    "output_contract": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "packet_markdown": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
