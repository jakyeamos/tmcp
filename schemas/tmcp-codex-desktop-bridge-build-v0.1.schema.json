{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmcp.dev/schemas/tmcp-codex-desktop-bridge-build-v0.1.schema.json",
  "title": "TMCP Codex Desktop bridge build descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_root",
    "protocol_method",
    "build_command",
    "test_command"
  ],
  "properties": {
    "schema": {
      "const": "tmcp-codex-desktop-bridge-build-v0.1"
    },
    "source_root": {
      "type": "string",
      "minLength": 1
    },
    "protocol_method": {
      "const": "thread/setupStatus/read"
    },
    "build_command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
