{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmcp.local/schemas/tmcp-handoff-manifest-v0.2.schema.json",
  "title": "TMCP owner-aware handoff manifest v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "exact_base", "custody", "files"],
  "properties": {
    "schema": {
      "const": "tmcp-handoff-manifest-v0.2"
    },
    "exact_base": {
      "type": "string",
      "minLength": 1
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream", "owner", "receipt"],
      "properties": {
        "stream": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "sha256", "freshness", "observed_at"],
          "properties": {
            "reference": {
              "$ref": "#/$defs/relativePath",
              "description": "Relative to the directory containing this manifest, which is the handoff receipt bundle."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "freshness": {
              "enum": ["current", "stale", "unknown"]
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "formatter_fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "config_sha256", "invocation", "mode"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "config_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "invocation": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "artifact_path", "bytes", "sha256", "custody"],
        "properties": {
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "artifact_path": {
            "$ref": "#/$defs/relativePath"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "custody": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "overlap"],
            "properties": {
              "status": {
                "enum": ["verified", "source_only", "unresolved", "stale"]
              },
              "overlap": {
                "enum": ["none", "shared", "unresolved"]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.?($|/))[^\\u0000]+$"
    }
  }
}
