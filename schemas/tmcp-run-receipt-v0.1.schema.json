{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakyeamos/tmcp/schemas/tmcp-run-receipt-v0.1.schema.json",
  "title": "TMCP Run Receipt v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "created_at",
    "packet_id",
    "activated_atoms",
    "ignored_atoms",
    "commands_run",
    "verification_results",
    "user_overrides",
    "outcome",
    "trust",
    "instruction_override_policy"
  ],
  "properties": {
    "schema": {
      "const": "tmcp-run-receipt-v0.1"
    },
    "created_at": {
      "type": "string"
    },
    "packet_id": {
      "type": "string"
    },
    "activated_atoms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ignored_atoms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_results": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "user_overrides": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recipe_id": {
      "type": "string",
      "minLength": 1
    },
    "task_identity": {
      "type": "object",
      "additionalProperties": true
    },
    "graph_digest": {
      "type": "string",
      "minLength": 1
    },
    "composition_plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase_capsule_binding_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "content_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "uniqueItems": true
    },
    "selected_skill_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phase_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "gate_results": {
      "type": "array",
      "description": "Structured gate outcomes. Project-recipe promotion requires at least one safety-classified gate with an explicit passing result, and rejects missing, ambiguous, or failing safety evidence.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "gate_id": { "type": "string" },
          "category": { "type": "string" },
          "safety": { "type": "boolean" },
          "passed": { "type": "boolean" },
          "status": { "type": "string" },
          "outcome": { "type": "string" },
          "result": { "type": "string" }
        }
      }
    },
    "handoff_results": {
      "type": "array",
      "description": "Structured producer-to-consumer artifact handoff outcomes observed during graph-aware execution.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "handoff_id": { "type": "string" },
          "producer_node_id": { "type": "string" },
          "consumer_node_id": { "type": "string" },
          "status": { "type": "string" },
          "consumed_inputs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "produced_outputs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "quality_metrics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "synergy_lift": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "compiler_lift": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "order_lift": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "cost_metrics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "context_tokens": {
          "type": "number",
          "minimum": 0
        },
        "context_ratio": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "execution_context": {
      "description": "Raw host-only phase-capsule residency evidence for a full-composition benchmark receipt.",
      "$ref": "tmcp-composition-benchmark-execution-context-v0.1.schema.json"
    },
    "benchmark_host_receipt": {
      "description": "Reserved marker for the in-memory composition benchmark host receipt path.",
      "const": "tmcp-composition-benchmark-host-only-v0.1"
    },
    "context_execution_mode": {
      "enum": ["isolated_phase_capsule", "same_host_transcript"]
    },
    "context_accounting_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "preflight_capsule_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase_capsule_trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage_id",
          "capsule_digest",
          "incoming_handoff_digests"
        ],
        "properties": {
          "stage_id": {"type": "string", "minLength": 1},
          "capsule_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "incoming_handoff_digests": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "host_composition_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "origin_digest",
        "origin_preflight_id",
        "runtime_snapshot_status",
        "runtime_preflight_id",
        "inherited_origin",
        "trust"
      ],
      "properties": {
        "schema": {
          "const": "tmcp-host-composition-receipt-provenance-v0.1"
        },
        "origin_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "origin_preflight_id": {
          "type": "string",
          "minLength": 1
        },
        "runtime_snapshot_status": {
          "enum": [
            "initial_frozen_snapshot",
            "runtime_capsule_revalidated",
            "runtime_capsule_rejected",
            "fresh_semantic_composition",
            "fresh_semantic_composition_rejected",
            "fresh_composition_required",
            "not_revalidated"
          ]
        },
        "runtime_preflight_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "inherited_origin": {
          "type": "boolean"
        },
        "trust": {
          "const": "advisory_untrusted"
        }
      }
    },
    "composition_fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_control_input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "benchmark_execution_recipe_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "benchmark_receipt_provenance": {
      "$ref": "tmcp-composition-benchmark-receipt-provenance-v0.1.schema.json"
    },
    "outcome": {
      "type": "string"
    },
    "trust": {
      "const": "advisory_untrusted"
    },
    "instruction_override_policy": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {"required": ["execution_context"]},
      "then": {
        "required": ["benchmark_host_receipt"],
        "properties": {
          "benchmark_host_receipt": {
            "const": "tmcp-composition-benchmark-host-only-v0.1"
          }
        }
      }
    },
    {
      "if": {"required": ["benchmark_host_receipt"]},
      "then": {
        "required": ["execution_context"]
      }
    },
    {
      "if": {"required": ["benchmark_receipt_provenance"]},
      "then": {
        "required": [
          "composition_fixture_id",
          "benchmark_control_input_digest",
          "benchmark_execution_recipe_digest",
          "composition_plan_digest",
          "phase_capsule_binding_digest",
          "context_execution_mode",
          "context_accounting_digest",
          "preflight_capsule_digest",
          "phase_capsule_trace"
        ],
        "not": {
          "anyOf": [
            {"required": ["execution_context"]},
            {"required": ["benchmark_host_receipt"]},
            {"required": ["host_artifact_digest"]},
            {"required": ["host_receipt_digest"]}
          ]
        }
      }
    },
    {
      "if": {
        "not": {
          "anyOf": [
            {"required": ["benchmark_host_receipt"]},
            {"required": ["benchmark_receipt_provenance"]}
          ]
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["execution_context"]},
            {"required": ["context_execution_mode"]},
            {"required": ["composition_fixture_id"]},
            {"required": ["benchmark_control_input_digest"]},
            {"required": ["benchmark_execution_recipe_digest"]},
            {"required": ["host_artifact_digest"]},
            {"required": ["host_receipt_digest"]}
          ]
        }
      }
    }
  ]
}
