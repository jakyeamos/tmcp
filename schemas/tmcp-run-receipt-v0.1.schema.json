{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakyeamos/tmcp/schemas/tmcp-run-receipt-v0.1.schema.json",
  "title": "TMCP Run Receipt v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "created_at",
    "packet_id",
    "activated_atoms",
    "ignored_atoms",
    "commands_run",
    "verification_results",
    "user_overrides",
    "outcome",
    "trust",
    "instruction_override_policy"
  ],
  "properties": {
    "schema": {
      "const": "tmcp-run-receipt-v0.1"
    },
    "created_at": {
      "type": "string"
    },
    "packet_id": {
      "type": "string"
    },
    "activated_atoms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ignored_atoms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_results": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "user_overrides": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recipe_id": {
      "type": "string",
      "minLength": 1
    },
    "task_identity": {
      "type": "object",
      "additionalProperties": true
    },
    "graph_digest": {
      "type": "string",
      "minLength": 1
    },
    "content_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "uniqueItems": true
    },
    "selected_skill_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phase_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "gate_results": {
      "type": "array",
      "description": "Structured gate outcomes. Project-recipe promotion requires at least one safety-classified gate with an explicit passing result, and rejects missing, ambiguous, or failing safety evidence.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "gate_id": { "type": "string" },
          "category": { "type": "string" },
          "safety": { "type": "boolean" },
          "passed": { "type": "boolean" },
          "status": { "type": "string" },
          "outcome": { "type": "string" },
          "result": { "type": "string" }
        }
      }
    },
    "handoff_results": {
      "type": "array",
      "description": "Structured producer-to-consumer artifact handoff outcomes observed during graph-aware execution.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "handoff_id": { "type": "string" },
          "producer_node_id": { "type": "string" },
          "consumer_node_id": { "type": "string" },
          "status": { "type": "string" },
          "consumed_inputs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "produced_outputs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "quality_metrics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "synergy_lift": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "compiler_lift": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "order_lift": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "cost_metrics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "context_tokens": {
          "type": "number",
          "minimum": 0
        },
        "context_ratio": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "composition_fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string"
    },
    "trust": {
      "const": "advisory_untrusted"
    },
    "instruction_override_policy": {
      "type": "string"
    }
  }
}
