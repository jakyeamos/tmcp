{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakyeamos/tmcp/schemas/tmcp-skill-evaluation-plan-v0.1.schema.json",
  "title": "TMCP Skill Evaluation Plan v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "created_at",
    "evaluated_skills",
    "task_matrix",
    "variants",
    "observable_behavior_contract",
    "runner_instructions",
    "evidence_contract",
    "guidebook_candidate_patterns"
  ],
  "properties": {
    "schema": {
      "const": "tmcp-skill-evaluation-plan-v0.1"
    },
    "created_at": {
      "type": "string"
    },
    "stability": {
      "type": "string"
    },
    "experiment": {
      "type": "object"
    },
    "evaluated_skills": {
      "type": "array"
    },
    "task_matrix": {
      "type": "array"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observable_behavior_contract": {
      "type": "array"
    },
    "packet_inclusion_contracts": {
      "type": "array"
    },
    "runner_instructions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_contract": {
      "type": "object"
    },
    "guidebook_candidate_patterns": {
      "type": "array"
    },
    "promotion_policy": {
      "type": "object"
    }
  }
}
