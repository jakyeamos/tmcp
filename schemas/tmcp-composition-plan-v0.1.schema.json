{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakyeamos/tmcp/schemas/tmcp-composition-plan-v0.1.schema.json",
  "title": "TMCP Composition Plan v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "composition_plan_id",
    "preflight_id",
    "current_phase",
    "task_model",
    "skill_roles",
    "typed_edges",
    "ordered_stages",
    "coverage",
    "provenance",
    "composition_diagnostics",
    "trust",
    "instruction_override_policy"
  ],
  "properties": {
    "schema": {
      "const": "tmcp-composition-plan-v0.1"
    },
    "composition_plan_id": {
      "type": "string",
      "pattern": "^composition-[a-f0-9]{20}$"
    },
    "preflight_id": {
      "type": "string",
      "pattern": "^preflight-[a-f0-9]{20}$"
    },
    "current_phase": { "type": "string", "minLength": 1 },
    "governing_node_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "task_model": {
      "$ref": "tmcp-semantic-proposal-v0.1.schema.json#/$defs/task_model"
    },
    "skill_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "tmcp-semantic-proposal-v0.1.schema.json#/$defs/skill_role" },
          {
            "type": "object",
            "properties": {
              "source_role": {
                "enum": ["governing_instruction", "active_skill"]
              },
              "activation": {
                "enum": ["active", "deferred"]
              }
            },
            "required": ["source_role", "activation"]
          }
        ]
      }
    },
    "typed_edges": {
      "type": "array",
      "items": {
        "$ref": "tmcp-semantic-proposal-v0.1.schema.json#/$defs/relationship"
      }
    },
    "handoff_contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/handoff_contract" }
    },
    "scoped_seed_graph_hints": {
      "type": "object",
      "additionalProperties": true
    },
    "ordered_stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "facets",
        "covered_criteria",
        "uncovered_criteria",
        "unresolved_gaps"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_digest",
        "recipe_digest",
        "content_digests",
        "normalized_relationship_count",
        "normalized_scoped_seed_relationship_count",
        "identity_policy"
      ],
      "properties": {
        "graph_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "recipe_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "content_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uniqueItems": true
        },
        "normalized_relationship_count": {
          "type": "integer",
          "minimum": 0
        },
        "normalized_scoped_seed_relationship_count": {
          "type": "integer",
          "minimum": 0
        },
        "identity_policy": {
          "const": "normalized_source_content_and_typed_relationships"
        }
      }
    },
    "phase_capsule_binding": {
      "$ref": "#/$defs/phase_capsule_binding"
    },
    "runtime_capsule": {
      "$ref": "#/$defs/runtime_capsule"
    },
    "composition_diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "missing_capabilities",
        "uncovered_criteria",
        "conflicts",
        "rejected_proposal_elements",
        "truncation",
        "process_only_warnings",
        "validation_warnings"
      ]
    },
    "trust": { "const": "advisory_untrusted" },
    "instruction_override_policy": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "phase_capsule_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "composition_plan_id",
        "composition_plan_digest",
        "preflight_id",
        "compiler_phase",
        "graph_digest",
        "recipe_digest",
        "context_accounting_digest",
        "preflight_capsule_digest",
        "phase_capsule_trace",
        "binding_digest"
      ],
      "properties": {
        "schema": { "const": "tmcp-composition-phase-capsule-binding-v0.1" },
        "composition_plan_id": {
          "type": "string",
          "pattern": "^composition-[a-f0-9]{20}$"
        },
        "composition_plan_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "preflight_id": {
          "type": "string",
          "pattern": "^preflight-[a-f0-9]{20}$"
        },
        "compiler_phase": {
          "enum": ["start", "discovery", "implementation", "verification", "final"]
        },
        "graph_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "recipe_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "context_accounting_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "preflight_capsule_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "phase_capsule_trace": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage_id",
              "capsule_digest",
              "incoming_handoff_digests"
            ],
            "properties": {
              "stage_id": { "type": "string", "minLength": 1 },
              "capsule_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "incoming_handoff_digests": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        },
        "binding_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "runtime_capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "composition_plan_id",
        "composition_plan_digest",
        "preflight_id",
        "compiler_phase",
        "graph_digest",
        "phase_capsule_binding_digest",
        "objective_digest",
        "task_identity_digest",
        "preparation_controls",
        "preparation_controls_digest",
        "cited_source_slices",
        "capsule_digest"
      ],
      "properties": {
        "schema": { "const": "tmcp-composition-runtime-capsule-v0.1" },
        "composition_plan_id": {
          "type": "string",
          "pattern": "^composition-[a-f0-9]{20}$"
        },
        "composition_plan_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "preflight_id": {
          "type": "string",
          "pattern": "^preflight-[a-f0-9]{20}$"
        },
        "compiler_phase": {
          "enum": ["start", "discovery", "implementation", "verification", "final"]
        },
        "graph_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "phase_capsule_binding_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "objective_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "task_identity_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "preparation_controls": {
          "$ref": "tmcp-composition-preflight-v0.1.schema.json#/$defs/preparation_controls"
        },
        "preparation_controls_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cited_source_slices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 48,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "original_node_id",
              "source_role",
              "source_digest",
              "slice_digest",
              "char_start",
              "char_end",
              "relative_path",
              "behavior_atoms"
            ],
            "properties": {
              "original_node_id": { "type": "string", "minLength": 1 },
              "source_role": {
                "enum": ["governing_instruction", "active_skill"]
              },
              "source_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "slice_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "char_start": { "type": "integer", "minimum": 0 },
              "char_end": { "type": "integer", "minimum": 1 },
              "relative_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "behavior_atoms": {
                "type": "array",
                "maxItems": 24,
                "items": { "type": "string", "minLength": 1, "maxLength": 240 },
                "uniqueItems": true
              }
            }
          }
        },
        "capsule_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "order",
        "phase",
        "status",
        "entry_conditions",
        "node_ids",
        "bridge_instructions"
      ],
      "properties": {
        "stage_id": {
          "type": "string",
          "pattern": "^stage-[0-9]+$"
        },
        "order": { "type": "integer", "minimum": 1 },
        "phase": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "deferred"] },
        "entry_conditions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "node_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "bridge_instructions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "instruction", "citations", "trust"],
            "properties": {
              "node_id": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "required_inputs": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "produced_outputs": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "exit_gates": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "handoff_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^handoff-[a-f0-9]{20}$"
                },
                "uniqueItems": true
              },
              "instruction": { "type": "string", "minLength": 1 },
              "citations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^slice-[a-f0-9]{20}$"
                }
              },
              "trust": { "const": "advisory_untrusted" }
            }
          }
        },
        "handoff_contracts": {
          "type": "array",
          "items": { "$ref": "#/$defs/handoff_contract" }
        }
      }
    },
    "handoff_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_id",
        "relationship_id",
        "producer_node_id",
        "consumer_node_id",
        "relationship_type",
        "required_inputs",
        "produced_outputs",
        "producer_exit_gates",
        "citations",
        "trust"
      ],
      "properties": {
        "handoff_id": {
          "type": "string",
          "pattern": "^handoff-[a-f0-9]{20}$"
        },
        "relationship_id": {
          "type": "string",
          "pattern": "^relationship-[a-f0-9]{16}$"
        },
        "producer_node_id": { "type": "string", "minLength": 1 },
        "consumer_node_id": { "type": "string", "minLength": 1 },
        "relationship_type": {
          "enum": [
            "requires",
            "precedes",
            "enables",
            "verifies",
            "produces",
            "consumes"
          ]
        },
        "required_inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "produced_outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "producer_exit_gates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^slice-[a-f0-9]{20}$"
          },
          "uniqueItems": true
        },
        "trust": { "const": "advisory_untrusted" }
      }
    }
  }
}
