{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakyeamos/tmcp/schemas/tmcp-skill-evaluation-report-v0.2.schema.json",
  "title": "TMCP Skill Evaluation Report v0.2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "created_at",
    "scorecard",
    "activation_scores",
    "adherence_scores",
    "outcome_scores",
    "case_scores",
    "pattern_effects",
    "pattern_claims",
    "anti_patterns",
    "no_op_patterns",
    "recommended_rewrites",
    "guidebook_entries",
    "skill_harvest_feedback"
  ],
  "properties": {
    "schema": {
      "const": "tmcp-skill-evaluation-report-v0.2"
    },
    "created_at": {"type": "string"},
    "stability": {"type": "string"},
    "scorecard": {"type": "object"},
    "activation_scores": {"type": "array"},
    "packet_inclusion_scores": {"type": "array"},
    "packet_inclusion_diffs": {"type": "array"},
    "adherence_scores": {"type": "array"},
    "outcome_scores": {"type": "array"},
    "case_scores": {"type": "array"},
    "cost_scores": {"type": "array"},
    "pattern_effects": {"type": "array"},
    "pattern_claims": {"type": "array"},
    "static_pattern_findings": {"type": "array"},
    "anti_patterns": {"type": "array"},
    "no_op_patterns": {"type": "array"},
    "recommended_rewrites": {"type": "array"},
    "guidebook_entries": {"type": "array"},
    "skill_harvest_feedback": {"type": "array"},
    "promotion_policy": {"type": "object"}
  }
}
